{
	"name": "discord-online-24-7",
	"version": "2.0.0",
	"description": "A simple script that keeps a Discord account active 24/7, written in TypeScript.",
	"homepage": "https://github.com/ashl3ycodes/Discord-Online-24-7",
	"bugs": {
		"url": "https://github.com/ashl3ycodes/Discord-Online-24-7/issues"
	},
	"license": "AGPL-3.0-only",
	"author": {
		"name": "ashl3ycodes",
		"url": "https://github.com/ashl3ycodes"
	},
	"type": "module",
	"main": "dist/index.js",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"build": "yarn clean && tsc --pretty false",
		"typecheck": "tsc --noEmit --pretty false",
		"watch": "tsc -w",
		"start": "node dist/index.js",
		"test": "yarn build && node test.js && node test-status.js",
		"deploy": "./deploy/deploy.sh"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/ws": "^8.18.1",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"ws": "^8.18.1"
	}
}
